<!-- Room Card partial — reusable card for displaying a room -->
<div class="room-card">
  <a href="/rooms/{{_id}}" class="room-card-link">
    <div class="room-card-header">
      <h3 class="room-card-title">{{name}}</h3>
      <span class="room-card-type">{{roomType}}</span>
    </div>
    <div class="room-card-budget">
      <p class="room-card-budget-label">Budget</p>
      <p class="room-card-budget-amount">₹{{budget}}</p>
    </div>
    <div class="room-card-stats">
      <span class="room-card-items">{{items.length}} items</span>
      <span class="room-card-total">Total: ₹{{total}}</span>
    </div>
  </a>
</div>
