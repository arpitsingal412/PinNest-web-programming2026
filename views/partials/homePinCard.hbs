<!-- Home Pin Card partial — full bleed image with bottom-left serif title pill -->
<div class="home-pin-card">
  <a href="/pins/{{_id}}" class="home-pin-card-link">
    <img src="{{imageUrl}}" alt="{{title}}" class="home-pin-card-image">
    <div class="home-pin-card-pill">
      <span>{{title}}</span>
    </div>
  </a>
</div>
