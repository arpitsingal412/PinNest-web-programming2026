<!-- Explore results card — always navigates to pin detail on click.
     Click always goes to the pin detail page. -->
<a href="/pins/{{_id}}" class="pin-card-masonry">
  <img src="{{imageUrl}}" alt="{{title}}" class="pin-card-masonry-image">
  <span class="pin-card-masonry-label">{{title}}</span>
</a>