<!-- Register Page — create a new PinNest account -->
<section class="auth-section">
  <div class="auth-card">

    <!-- Hero header inside glass card -->
    <div class="auth-hero">
      <span class="auth-eyebrow">PinNest</span>
      <h1 class="auth-title">Create Account</h1>
      <p class="auth-subtitle">Join PinNest to save furniture ideas, curate boards, and design rooms</p>
    </div>

    <!-- Error message from the controller -->
    {{#if error}}
    <div class="auth-error-banner" role="alert">
      <span>{{error}}</span>
    </div>
    {{/if}}

    <!-- Registration form -->
    <form action="/register" method="POST" class="auth-form" id="register-form">
      <div class="form-group">
        <label for="register-name">Full Name</label>
        <input type="text" id="register-name" name="name" class="form-input"
               placeholder="Your name" value="{{name}}" required>
      </div>

      <div class="form-group">
        <label for="register-email">Email Address</label>
        <input type="email" id="register-email" name="email" class="form-input"
               placeholder="you@example.com" value="{{email}}" required>
      </div>

      <!-- Password + Confirm Password sit side by side -->
      <div class="form-row-group">
        <div class="form-group">
          <label for="register-password">Password</label>
          <input type="password" id="register-password" name="password" class="form-input"
                 placeholder="At least 6 characters" required>
        </div>

        <div class="form-group">
          <label for="register-confirm-password">Confirm Password</label>
          <input type="password" id="register-confirm-password" name="confirmPassword"
                 class="form-input" placeholder="Confirm password" required>
        </div>
      </div>

      <div class="form-group">
        <label for="register-bio">Bio (optional)</label>
        <input type="text" id="register-bio" name="bio" class="form-input"
               placeholder="e.g. Interior design enthusiast">
      </div>

      <button type="submit" class="btn btn-primary btn-large auth-submit">Create Account</button>
    </form>

    <p class="auth-switch">
      Already have an account? <a href="/login">Log in here</a>
    </p>

  </div>
</section>
